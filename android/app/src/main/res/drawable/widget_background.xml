<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#7C3AED"
                android:centerColor="#9333EA"
                android:endColor="#A855F7"
                android:type="linear"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    
    <!-- Frosted glass effect - multiple layers for Apple-style blur -->
    <!-- Layer 1: Overall white tint for glass look -->
    <item>
        <shape>
            <solid android:color="#35FFFFFF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    
    <!-- Layer 2: Subtle noise/texture effect across entire surface -->
    <item>
        <shape>
            <gradient
                android:angle="45"
                android:startColor="#18FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#18FFFFFF"
                android:type="linear"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    
    <!-- Layer 3: Gentle radial glow covering whole surface -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    
    <!-- Large circle top right -->
    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="top|end"
        android:top="-30dp"
        android:right="-30dp">
        <shape android:shape="oval">
            <solid android:color="#20FFFFFF"/>
        </shape>
    </item>
    
    <!-- Medium circle bottom left -->
    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="bottom|start"
        android:bottom="-20dp"
        android:left="-20dp">
        <shape android:shape="oval">
            <solid android:color="#15FFFFFF"/>
        </shape>
    </item>
    
    <!-- Small circle top left -->
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="top|start"
        android:top="15dp"
        android:left="10dp">
        <shape android:shape="oval">
            <solid android:color="#12FFFFFF"/>
        </shape>
    </item>
    
    <!-- Tiny accent circle middle right -->
    <item
        android:width="25dp"
        android:height="25dp"
        android:gravity="center|end"
        android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="#18FFFFFF"/>
        </shape>
    </item>
</layer-list>
