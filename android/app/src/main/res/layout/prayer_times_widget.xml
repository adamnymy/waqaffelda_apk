<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:gravity="center"
    android:background="@drawable/widget_background">

    <!-- Location at top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"/>
        
        <TextView
            android:id="@+id/location_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loading..."
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:alpha="0.95"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:ellipsize="marquee"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- Date below location -->
    <TextView
        android:id="@+id/date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="22 Dis 2025"
        android:textSize="8sp"
        android:textColor="#FFFFFF"
        android:alpha="0.8"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginBottom="6dp"/>

    <!-- Main content - Next prayer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical|start">

        <!-- Waktu Solat label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAKTU SOLAT"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:alpha="0.85"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp"/>

        <!-- Prayer name (smaller to fit 2x2) -->
        <TextView
            android:id="@+id/next_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subuh"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp"/>

            <!-- Time - Large and prominent -->
            <TextView
                android:id="@+id/next_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:45"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"/>

            <!-- Countdown removed for compact widget -->
        </LinearLayout>

        <!-- Compact column showing today's prayer times: 2 items left, 3 items right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <!-- Left column: 2 items -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:id="@+id/subuh_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subuh"
                        android:textSize="9sp"
                        android:textColor="#DDE6FF"/>
                    <TextView
                        android:id="@+id/subuh_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:45"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/zohor_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zohor"
                        android:textSize="9sp"
                        android:textColor="#DDE6FF"/>
                    <TextView
                        android:id="@+id/zohor_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13:05"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Right column: 3 items -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:id="@+id/asar_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asar"
                        android:textSize="9sp"
                        android:textColor="#DDE6FF"/>
                    <TextView
                        android:id="@+id/asar_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:30"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:id="@+id/maghrib_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textSize="9sp"
                        android:textColor="#DDE6FF"/>
                    <TextView
                        android:id="@+id/maghrib_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19:12"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/isyak_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isyak"
                        android:textSize="9sp"
                        android:textColor="#DDE6FF"/>
                    <TextView
                        android:id="@+id/isyak_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20:30"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

</LinearLayout>
