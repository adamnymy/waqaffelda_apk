<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@drawable/widget_background">

    <!-- Location at top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"/>
        
        <TextView
            android:id="@+id/location_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loading..."
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:alpha="0.95"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:ellipsize="marquee"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- Date below location -->
    <TextView
        android:id="@+id/date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="22 Dis 2025"
        android:textSize="9sp"
        android:textColor="#FFFFFF"
        android:alpha="0.8"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Main content - Next prayer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical|start">

        <!-- Waktu Solat label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAKTU SOLAT"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:alpha="0.85"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp"/>

        <!-- Prayer name -->
        <TextView
            android:id="@+id/next_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subuh"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp"/>

        <!-- Time - Large and prominent -->
        <TextView
            android:id="@+id/next_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:45"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-light"/>
    </LinearLayout>

    <!-- Hidden TextViews for other prayer times and countdown -->
    <TextView android:id="@+id/next_prayer_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/countdown_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/subuh_time" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/syuruk_time" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/zohor_time" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/asar_time" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/maghrib_time" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/isyak_time" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</LinearLayout>
